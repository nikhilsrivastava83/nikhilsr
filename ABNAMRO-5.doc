    <table cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td id="descriptionArea">
            <div class='je_rdata_container je_html' style='text-align:start'><div class='je_preview'><p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"><b><span style="color:#000000">GET /category</span></b></p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"><span style="color:#000000">The<span>&nbsp;</span><b>Browse Category</b><span>&nbsp;</span>capability enables retrieving a category list from C1 by sales channel.&nbsp;Each category in the list is returned with its category code (a unique name) and category display name.</span></p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"><b><span style="color:#000000">GET /category/{id}</span></b></p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"><span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial">The Category Details capability (GET /category)/{id}) allows retrieving a specific category using its identifier (either ID or name).</span></p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial">&nbsp;</p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"><span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial">The Feature Certified the above operations. </span></p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"><span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial">Return Browsing Categories by <b>Self Service</b>&nbsp;Channel from ABN AMRO&nbsp;C1.</span></p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"><span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial">e.g:</span></p>

<ul>
	<li style="margin: 10px 0px 0px; text-decoration-thickness: initial;">Personal
	<ul>
		<li style="margin: 10px 0px 0px; text-decoration-thickness: initial;">Bundles
		<ul>
			<li style="margin: 10px 0px 0px; text-decoration-thickness: initial;">Payment Bundles</li>
		</ul>
		</li>
	</ul>
	</li>
	<li style="margin: 10px 0px 0px; text-decoration-thickness: initial;">Commercial</li>
	<li style="margin: 10px 0px 0px; text-decoration-thickness: initial;">Private Banking</li>
</ul>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial">&nbsp;</p>

<p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial">&nbsp;</p></div><div class='je_sep' style='display:none'>&nbsp;&zwnj;</div><div class='je_cdata' style='display:none'><!--&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&lt;b&gt;&lt;span style="color:#000000"&gt;GET /category&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&lt;span style="color:#000000"&gt;The&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;b&gt;Browse Category&lt;/b&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;capability enables retrieving a category list from C1 by sales channel.&amp;nbsp;Each category in the list is returned with its category code (a unique name) and category display name.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&lt;b&gt;&lt;span style="color:#000000"&gt;GET /category/{id}&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&lt;span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial"&gt;The Category Details capability (GET /category)/{id}) allows retrieving a specific category using its identifier (either ID or name).&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&amp;nbsp;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&lt;span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial"&gt;The Feature Certified the above operations. &lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&lt;span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial"&gt;Return Browsing Categories by &lt;b&gt;Self Service&lt;/b&gt;&amp;nbsp;Channel from ABN AMRO&amp;nbsp;C1.&lt;/span&gt;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&lt;span style="color:#000000; display:inline; float:none; text-decoration-thickness:initial"&gt;e.g:&lt;/span&gt;&lt;/p&gt;

&lt;ul&gt;
	&lt;li style="margin: 10px 0px 0px; text-decoration-thickness: initial;"&gt;Personal
	&lt;ul&gt;
		&lt;li style="margin: 10px 0px 0px; text-decoration-thickness: initial;"&gt;Bundles
		&lt;ul&gt;
			&lt;li style="margin: 10px 0px 0px; text-decoration-thickness: initial;"&gt;Payment Bundles&lt;/li&gt;
		&lt;/ul&gt;
		&lt;/li&gt;
	&lt;/ul&gt;
	&lt;/li&gt;
	&lt;li style="margin: 10px 0px 0px; text-decoration-thickness: initial;"&gt;Commercial&lt;/li&gt;
	&lt;li style="margin: 10px 0px 0px; text-decoration-thickness: initial;"&gt;Private Banking&lt;/li&gt;
&lt;/ul&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&amp;nbsp;&lt;/p&gt;

&lt;p style="margin-bottom:0px; margin-left:0px; margin-right:0px; margin-top:10px; text-decoration-thickness:initial"&gt;&amp;nbsp;&lt;/p&gt;
